{
  "name": "storage-ae-employee-management",
  "version": "1.0.0",
  "private": true,
  "description": "storage.ae People Operations: recruitment to onboarding to training, with role-based access.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "migrate": "node server/src/migrate.js",
    "seed": "node server/src/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
